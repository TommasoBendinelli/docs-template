\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{manual_style}[2026/05/11 Generic manual docs PDF style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[a4paper]{geometry}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{hyperref}
\RequirePackage{xurl}
\RequirePackage{xspace}
\RequirePackage{xcolor}
\RequirePackage{currfile}
\RequirePackage{fancyvrb}
\RequirePackage{fvextra}
\RequirePackage{etoolbox}
\RequirePackage{array}
\RequirePackage{amssymb}
\RequirePackage{amsmath}
\RequirePackage{longtable}
\RequirePackage{float}
\RequirePackage{listings}

\makeatletter
\InputIfFileExists{\currfiledir manual_docs_layout_config.tex}{}{}
\@ifundefined{manualDocLeftPaddingDelta}{%
  \newcommand{\manualDocLeftPaddingDelta}{0pt}%
}{}
\@ifundefined{manualDocRightPaddingDelta}{%
  \newcommand{\manualDocRightPaddingDelta}{0pt}%
}{}
\@ifundefined{manualDocBrand}{%
  \newcommand{\manualDocBrand}{Docs}%
}{}
\@ifundefined{manualDocDefaultSourceBaseName}{%
  \newcommand{\manualDocSourceBaseName}{\jobname.tex}%
}{%
  \newcommand{\manualDocSourceBaseName}{\manualDocDefaultSourceBaseName}%
}
\makeatother

\newlength{\manualDocLeftMargin}
\newlength{\manualDocRightMargin}
\setlength{\manualDocLeftMargin}{1in}
\addtolength{\manualDocLeftMargin}{\manualDocLeftPaddingDelta}
\setlength{\manualDocRightMargin}{1in}
\addtolength{\manualDocRightMargin}{\manualDocRightPaddingDelta}
\geometry{
  left=\manualDocLeftMargin,
  right=\manualDocRightMargin,
  top=1in,
  bottom=1in
}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}
\setlength{\headheight}{14pt}
\emergencystretch=1em
\setlength{\LTcapwidth}{\textwidth}

\setlist[itemize,1]{leftmargin=1.5em,itemsep=0.25em,topsep=0.3em}
\setlist[itemize,2]{leftmargin=2.8em,itemsep=0.1em,topsep=0.1em,font=\small}
\setlist[enumerate,1]{leftmargin=1.7em,itemsep=0.25em,topsep=0.3em}

\urlstyle{same}
\newcommand{\manualDocName}{}
\newcommand{\setManualDocSourceName}[1]{\renewcommand{\manualDocSourceBaseName}{#1}}
\newcommand{\manualDocSourceName}{\code{\manualDocSourceBaseName}}
\newcommand{\code}[1]{%
  \begingroup
  \def\UrlFont{\ttfamily}%
  \nolinkurl{#1}%
  \endgroup
}
\newcommand{\titlecode}[1]{\code{#1}}

\newcommand{\docTitle}[2][]{%
  \renewcommand{\manualDocName}{#2}%
  \if\relax\detokenize{#1}\relax
  \else
    \renewcommand{\manualDocName}{#1}%
  \fi
  \fancyhf{}%
  \fancyhead[L]{\footnotesize \manualDocBrand{} | \manualDocName{} | \manualDocSourceName}%
  \fancyhead[R]{\today}%
  \fancyfoot[C]{\thepage}%
  \pagestyle{fancy}%
  {\centering\LARGE\bfseries #2\par}%
  \vspace{0.5em}%
}

\DefineVerbatimEnvironment{DocCode}{Verbatim}{
  fontsize=\small,
  breaklines=true,
  breakanywhere=true,
  breaksymbolleft={},
  breaksymbolright={}
}

\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}

